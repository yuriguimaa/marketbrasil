# Copie para backend/.env e preencha. As chaves ficam somente no servidor.
PORT=8787

# B3 — https://brapi.dev (plano gratuito). Sem token: apenas PETR4, VALE3, MGLU3, ITUB4.
BRAPI_TOKEN=

# EUA — https://finnhub.io (chave gratuita)
FINNHUB_TOKEN=

# Opcional: origens extras autorizadas a chamar a API (CORS), separadas por vírgula.
# Deixe vazio quando frontend e API são servidos pelo mesmo domínio.
ALLOWED_ORIGINS=

# Opcional: requisições por minuto por IP na /api (padrão 240)
RATE_LIMIT=240

# Use 1 quando a API estiver atrás de proxy reverso (nginx, Cloudflare) para limitar por IP real
TRUST_PROXY=0

# Use "production" ao publicar (ativa cache de arquivos estáticos em memória)
NODE_ENV=development

# Índices via Yahoo Finance (API não oficial). Use 0 para desativar.
YAHOO_ENABLED=1
